# Server
PORT=3000
NODE_ENV=production

# Security — use a long random string in production
JWT_SECRET=replace-with-a-long-random-secret
COOKIE_SECURE=true

# Database
# Leave empty to use local SQLite at ./data/rentflow.db
# For cloud, use a free PostgreSQL URL from Neon or Supabase:
# DATABASE_URL=postgresql://user:password@host/rentflow?sslmode=require
DATABASE_URL=
PGSSL=true

# Used to build absolute links inside WhatsApp reminder messages
PUBLIC_BASE_URL=https://your-rentflow-app.onrender.com

# Mobile app (Capacitor): the URL the iOS/Android app loads.
# Use your deployed HTTPS URL for devices, or http://<your-lan-ip>:3000 for local testing.
RENTFLOW_URL=https://your-rentflow-app.onrender.com

# Set to false to start with an empty rooms/tenants list
SEED_DEMO=true

# Electricity (BSES Delhi) online lookup
# BSES has no free public API. Leave empty to use manual readings + the BSES website link.
# If you have a provider API, set its endpoint here. See README "Electricity" section.
ELECTRICITY_API_URL=
ELECTRICITY_API_KEY=
