{
  "name": "rentflow",
  "version": "1.0.0",
  "private": true,
  "description": "Family rental room manager with real-time sync, dues, reminders, receipts and reports.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "reset:demo": "node scripts/reset-demo.js",
    "build:native": "esbuild scripts/native-entry.js --bundle --format=iife --target=es2019 --outfile=public/js/native.js --minify",
    "mobile:add": "npm run build:native && cap add android && cap add ios",
    "mobile:sync": "npm run build:native && cap sync",
    "mobile:android": "cap open android",
    "mobile:ios": "cap open ios",
    "mobile:build:android": "cap build android"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.4",
    "@capacitor/camera": "^7.0.5",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/network": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
